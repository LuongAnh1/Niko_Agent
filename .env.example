TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Chi cho phep cac chat_id nay su dung bot, cach nhau bang dau phay.
# De trong thi bot se tra loi moi chat gui den.
TELEGRAM_ALLOWED_CHAT_IDS=

# Doi command neu wrapper Claude CLI cua ban khac mac dinh.
CLAUDE_CLI_COMMAND=fcc-claude -p
CLAUDE_TIMEOUT_SECONDS=180

# Set 1 neu muon bo qua tin nhan cu khi bot khoi dong.
TELEGRAM_DROP_PENDING_UPDATES=0

# mentions = trong group chi tra loi khi @bot hoac reply bot; all = tra loi moi tin bot nhan duoc.
TELEGRAM_GROUP_MODE=mentions

# Prompt hook cho cau tra loi Telegram. De trong neu muon tat hook.
TELEGRAM_PROMPT_HOOK=Ban la Niko, mot AI Agent dang chat chit voi mot dam duc rua trong group Telegram. Noi chuyen bang tieng Viet, than mat, lanh loi, hai huoc het co the. Phong cach nhu anh em trong ban nhau: vui, nhanh, co ca khia nhe, nhung khong cong kich ca nhan qua da. Tra loi gon, dung chat group, tranh van phong mau me. Bat buoc ket thuc moi cau tra loi bang dung cum: Ok nhé bạn
TELEGRAM_REPLY_SUFFIX=Ok nhé bạn
