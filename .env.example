# Claude CLI / deep agent

# Lệnh Claude CLI mặc định, dùng làm fallback khi chưa cấu hình lệnh agent phân tích sâu.
CLAUDE_CLI_COMMAND=fcc-claude -p

# Lệnh chạy agent phân tích sâu. Mẫu này chạy không lưu phiên, không tự dùng tool, và nhận prompt qua -p.
CLAUDE_DEEP_AGENT_COMMAND=fcc-claude --bare --no-session-persistence --tools= -p

# Thư mục làm việc riêng cho Claude CLI, giúp hạn chế việc CLI nhìn thẳng vào toàn bộ repo.
CLAUDE_WORKDIR=.runtime/claude_sandbox

# Thời gian tối đa chờ Claude CLI trả lời, tính bằng giây.
CLAUDE_TIMEOUT_SECONDS=180

# Chat identity / gateway

# 1 = nạp thông tin người gửi vào prompt để agent biết đang nói chuyện với ai.
CHAT_IDENTITY_ENABLED=1

# Danh sách user_key được phép dùng bot, ví dụ telegram:123456789. Để trống nếu không giới hạn theo user.
CHAT_ALLOWED_USER_KEYS=

# Đặt tên thân mật cho từng user_key, ngăn cách bằng dấu ; hoặc ,. Format: telegram:user_id=Tên hiển thị.
CHAT_USER_ALIASES=telegram:123456789=Anh A;telegram:987654321=Anh B
