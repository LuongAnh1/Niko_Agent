# Claude CLI / deep agent

# Command mac dinh de goi Claude CLI. Niko se truyen prompt vao stdin hoac -p tuy command.
CLAUDE_CLI_COMMAND=fcc-claude -p

# Command rieng cho deep agent. De trong thi Niko dung CLAUDE_CLI_COMMAND.
CLAUDE_DEEP_AGENT_COMMAND=fcc-claude --bare --no-session-persistence --tools= -p

# Thu muc lam viec rieng cho Claude CLI, giup CLI khong nhin thang vao toan bo repo.
CLAUDE_WORKDIR=.runtime/claude_sandbox

# So giay toi da cho Claude CLI tra loi.
CLAUDE_TIMEOUT_SECONDS=180

# Niko core agent

# Che do agent: single = day thang vao deep agent, two_agent = tra loi nhanh neu duoc va chay deep agent nen.
NIKO_AGENT_MODE=two_agent

# Command cho fast agent. De trong thi Niko chi dung rule noi bo cho cac cau don gian.
NIKO_FAST_AGENT_COMMAND=

# So giay toi da cho fast agent tra loi.
NIKO_FAST_AGENT_TIMEOUT_SECONDS=45

# Delay cho cau hoi khong ro local/deep truoc khi bao dang chuyen sang deep agent.
NIKO_UNCERTAIN_DELAY_SECONDS=3

# Tin nhan gui ngay khi deep agent bat dau xu ly.
NIKO_DEEP_WAIT_REPLY=Da anh doi em chut, cau nay can phan tich ky hon nen em day sang Opus 5 roi bao lai anh ngay.

# Tin nhan gui khi deep agent van dang xu ly cau truoc.
NIKO_DEEP_BUSY_REPLY=Da anh doi em chut, em van dang xu ly cau truoc. Anh cu nhan tiep, khi co ket qua em se gui lai.

# File hook/persona nap vao prompt cua Niko. Sua HOOK.md thay vi sua script.
NIKO_PROMPT_HOOK_FILE=HOOK.md

# Hau to luon gan cuoi cau tra loi.
NIKO_REPLY_SUFFIX=Meow

# Cau thay the khi Claude sinh tool-call gia nhung harness chua cap tool.
NIKO_TOOL_UNAVAILABLE_REPLY=Da hien tai em khong co quyen tu doc file hay quet thu muc. Neu anh muon em xem file/tai lieu nao, anh gui noi dung hoac de harness nap phan lien quan vao prompt giup em nhe.

# Chat identity / gateway

# 1 = nap thong tin nguoi gui vao prompt de Niko biet dang noi voi ai.
CHAT_IDENTITY_ENABLED=1

# Danh sach user_key duoc phep dung agent, cach nhau bang dau phay. De trong neu khong gioi han theo user.
CHAT_ALLOWED_USER_KEYS=

# Dat ten hien thi cho user_key. Format: telegram:user_id=Ten;telegram:user_id=Ten khac
CHAT_USER_ALIASES=telegram:123456789=Anh A;telegram:987654321=Anh B
