TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Chi cho phep cac chat_id nay su dung bot, cach nhau bang dau phay.
# De trong thi bot se tra loi moi chat gui den.
TELEGRAM_ALLOWED_CHAT_IDS=

# Nhan dien nguoi chat. Dung /whoami hoac /id de lay user_key.
CHAT_IDENTITY_ENABLED=1
CHAT_ALLOWED_USER_KEYS=
CHAT_USER_ALIASES=telegram:123456789=Anh A;telegram:987654321=Anh B

# Command Claude CLI cho deep agent.
CLAUDE_CLI_COMMAND=fcc-claude -p
CLAUDE_DEEP_AGENT_COMMAND=
CLAUDE_TIMEOUT_SECONDS=180

# Set 1 neu muon bo qua tin nhan cu khi bot khoi dong.
TELEGRAM_DROP_PENDING_UPDATES=0

# mentions = trong group chi tra loi khi @bot hoac reply bot; all = tra loi moi tin bot nhan duoc.
TELEGRAM_GROUP_MODE=mentions

# two_agent = phan hoi nhanh ngay, cau kho chay Opus/deep agent o background.
# single = moi tin doi deep agent xong moi tra loi.
TELEGRAM_AGENT_MODE=two_agent
TELEGRAM_FAST_AGENT_COMMAND=
TELEGRAM_FAST_AGENT_TIMEOUT_SECONDS=45
TELEGRAM_UNCERTAIN_DELAY_SECONDS=3
TELEGRAM_DEEP_WAIT_REPLY=Dạ anh đợi em chút, câu này cần phân tích kỹ hơn nên em đẩy sang Opus 5 rồi báo lại anh ngay.
TELEGRAM_DEEP_BUSY_REPLY=Dạ anh đợi em chút, em vẫn đang xử lý câu trước. Anh cứ nhắn tiếp, khi có kết quả em sẽ gửi lại.

# Prompt hook cho cau tra loi Telegram. Sua noi dung trong HOOK.md, khong can sua script.
TELEGRAM_PROMPT_HOOK_FILE=HOOK.md
TELEGRAM_REPLY_SUFFIX=Meow

# Sticker Ducks local picker.
TELEGRAM_STICKERS_ENABLED=1
TELEGRAM_STICKER_CONFIG_FILE=stickers/ducks.json
TELEGRAM_STICKER_SET_NAME=UtyaDuck
TELEGRAM_STICKER_MODE=smart
