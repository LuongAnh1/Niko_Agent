# Niko dashboard bootstrap
#
# Luồng chính bây giờ là:
#   1. Chạy dashboard: python -m niko.ops.dashboard
#   2. Mở http://127.0.0.1:7777
#   3. Nhập Telegram token, agent commands, Nimble/sticker/memory/reply config trong tab Config
#   4. Start Telegram bot và warmup/stop Decision Model trong tab Bots
#
# Runtime config/secret được lưu local tại niko/.runtime/config.json và không commit.
# Env chỉ nên dùng cho bootstrap dashboard hoặc override khẩn cấp trên máy dev.

NIKO_OPS_HOST=127.0.0.1
NIKO_OPS_PORT=7777
NIKO_RUNTIME_CONFIG_FILE=niko/.runtime/config.json
