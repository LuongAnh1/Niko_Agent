# Telegram bot

# Token của bot Telegram, lấy từ @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Danh sách chat_id được phép dùng bot, ngăn cách bằng dấu phẩy. Để trống nếu muốn cho mọi chat gọi bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# Telegram polling

# 1 = bỏ qua tin nhắn cũ đang tồn khi bot vừa khởi động, 0 = xử lý cả backlog.
TELEGRAM_DROP_PENDING_UPDATES=0

# Chế độ trong group: mentions = chỉ xử lý khi tag @bot, all = xử lý mọi tin nhắn text trong chat được phép.
TELEGRAM_GROUP_MODE=mentions

# 1 = khi trả lời sẽ tag người gửi, hữu ích khi bot chạy trong group.
TELEGRAM_MENTION_REPLIES=1

# Two-agent flow

# Chế độ điều phối agent: two_agent = agent nhanh phân loại trước, deep = đẩy thẳng sang agent phân tích sâu.
TELEGRAM_AGENT_MODE=two_agent

# Lệnh agent nhanh. Để trống thì bot dùng rule nội bộ để quyết định trả lời nhanh hay đẩy sang agent sâu.
TELEGRAM_FAST_AGENT_COMMAND=

# Thời gian tối đa chờ agent nhanh trả lời, tính bằng giây.
TELEGRAM_FAST_AGENT_TIMEOUT_SECONDS=45

# Độ trễ trước khi báo đang chuyển sang agent sâu với câu chưa chắc chắn, tính bằng giây.
TELEGRAM_UNCERTAIN_DELAY_SECONDS=3

# Tin nhắn gửi ngay cho người dùng khi câu hỏi cần agent phân tích sâu xử lý.
TELEGRAM_DEEP_WAIT_REPLY=Dạ anh đợi em chút, câu này cần phân tích kỹ hơn nên em đẩy sang Opus 5 rồi báo lại anh ngay.

# Tin nhắn gửi khi agent sâu vẫn đang xử lý mà người dùng tiếp tục nhắn thêm.
TELEGRAM_DEEP_BUSY_REPLY=Dạ anh đợi em chút, em vẫn đang xử lý câu trước. Anh cứ nhắn tiếp, khi có kết quả em sẽ gửi lại.

# Prompt hook

# File chứa hook/persona nạp vào prompt, chỉnh giọng bot trong HOOK.md thay vì sửa script.
TELEGRAM_PROMPT_HOOK_FILE=HOOK.md

# Hậu tố luôn gắn cuối câu trả lời của bot.
TELEGRAM_REPLY_SUFFIX=Meow

# Câu trả lời thay thế khi Claude sinh ra yêu cầu tool giả như read/search nhưng bot không cấp tool đó.
TELEGRAM_TOOL_UNAVAILABLE_REPLY=Dạ hiện tại em không có quyền tự đọc file hay quét thư mục. Nếu anh muốn em xem file/tài liệu nào, anh gửi nội dung hoặc để harness nạp phần liên quan vào prompt giúp em nhé.

# Sticker Ducks local picker

# 1 = bật chọn và gửi sticker Telegram theo nội dung phản hồi.
TELEGRAM_STICKERS_ENABLED=1

# File JSON ánh xạ cảm xúc/từ khóa sang sticker_id của bộ sticker.
TELEGRAM_STICKER_CONFIG_FILE=stickers/ducks.json

# Tên bộ sticker Telegram dùng để đồng bộ hoặc tham chiếu, hiện là Ducks/UtyaDuck.
TELEGRAM_STICKER_SET_NAME=UtyaDuck

# Chế độ gửi sticker: smart = tự chọn theo nội dung, off = tắt logic chọn sticker.
TELEGRAM_STICKER_MODE=smart
