# Telegram gateway

# Token cua bot Telegram, lay tu @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Danh sach chat_id duoc phep dung bot, cach nhau bang dau phay. De trong neu cho moi chat goi bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# 1 = bo qua tin nhan cu dang ton khi bot vua khoi dong.
TELEGRAM_DROP_PENDING_UPDATES=0

# Timeout/retry cho request Telegram API. Neu mang cham, tang timeout len 120-180.
TELEGRAM_REQUEST_TIMEOUT_SECONDS=75
TELEGRAM_CHAT_ACTION_TIMEOUT_SECONDS=5
TELEGRAM_STARTUP_RETRIES=2
TELEGRAM_STARTUP_RETRY_DELAY_SECONDS=3

# Che do trong group: mentions = chi xu ly khi tag @bot, all = xu ly moi text trong chat duoc phep.
TELEGRAM_GROUP_MODE=mentions

# 1 = khi tra loi se tag nguoi vua goi bot.
TELEGRAM_MENTION_REPLIES=1

# Sticker Ducks local picker

# 1 = bat gui sticker Telegram theo noi dung phan hoi.
TELEGRAM_STICKERS_ENABLED=1

# 1 = dung Nimble local de chon mood sticker. Neu tat, bot khong fallback keyword rule.
TELEGRAM_STICKER_DECISION_MODEL_ENABLED=1

# Timeout rieng cho Nimble sticker mood. De trong thi dung NIKO_DECISION_MODEL_TIMEOUT_SECONDS.
TELEGRAM_STICKER_DECISION_MODEL_TIMEOUT_SECONDS=5

# File JSON anh xa mood sang sticker Telegram.
TELEGRAM_STICKER_CONFIG_FILE=bots/telegram/stickers/ducks.json

# Ten sticker set Telegram Duck/UtyaDuck.
TELEGRAM_STICKER_SET_NAME=UtyaDuck

# Che do gui sticker: smart/always = cho phep Nimble chon mood, off = tat.
TELEGRAM_STICKER_MODE=smart

# Timeout rieng cho sticker de khong lam cham phan hoi chinh.
TELEGRAM_STICKER_TIMEOUT_SECONDS=5
